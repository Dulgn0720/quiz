NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated origins allowed to call the API (the web app)
CORS_ORIGINS=http://localhost:5173
# Where uploaded question images are stored, and the public URL the API is reachable at
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:3000
# Set to true behind a reverse proxy so join rate limits use the real client address
TRUST_PROXY=false
# Signs login tokens (32+ characters). Required in production; development uses a built-in value.
# JWT_SECRET=
