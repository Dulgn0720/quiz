# Copy to deploy/portal/.env and fill in. Never commit the real file.

# Host name of the employee portal (no https://, no path).
PORTAL_HOST=portal.agula.mn
# Where on the portal Agula Quiz lives. Must match the portal's proxy rule (see README.md).
QUIZ_PATH=/quiz
# Local port the portal's web server forwards to.
QUIZ_PORT=8090

# Random secrets: openssl rand -hex 24 / openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Shared with the portal's backend so it can sign employees in (openssl rand -hex 32). Leave empty to turn off.
PORTAL_SSO_SECRET=

# Admin accounts (emails, comma-separated). true: only admins create or edit quizzes.
ADMIN_EMAILS=
RESTRICT_QUIZ_EDITING=true

# Optional mail for password reset links.
SMTP_URL=
MAIL_FROM=Agula Quiz <no-reply@agula.mn>

BACKUP_KEEP_DAYS=14
