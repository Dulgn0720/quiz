# Copy to deploy/.env and fill in. Never commit the real file.

# Public domain pointing at this server (DNS A record). Caddy issues the HTTPS certificate for it.
DOMAIN=quiz.agula.mn

# Database password (any long random string). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens, 32+ characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Emails of the admin accounts (they register normally on the site), comma-separated.
ADMIN_EMAILS=
# true: only admins may create, edit, import or delete quizzes. Everyone can still host and play.
RESTRICT_QUIZ_EDITING=true
