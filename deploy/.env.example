# Copy to deploy/.env and fill in. Never commit the real file.

# Public domain pointing at this server (DNS A record). Caddy issues the HTTPS certificate for it.
DOMAIN=quiz.agula.mn

# Database password (any long random string). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens, 32+ characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Emails of the admin accounts (they register normally on the site), comma-separated.
ADMIN_EMAILS=
# true: only admins may create, edit, import or delete quizzes. Everyone can still host and play.
RESTRICT_QUIZ_EDITING=true

# Optional: outgoing mail for password reset links, e.g. smtp://user:password@smtp.gmail.com:587
# Without it, reset links are written to the api log (docker compose logs api | grep "reset link").
SMTP_URL=
MAIL_FROM=Agula Quiz <no-reply@agula.mn>

# Optional: where to send "site is down / back up" alerts.
# Slack/Mattermost/Discord incoming webhook URL:
ALERT_WEBHOOK_URL=
# Or Telegram (create a bot with @BotFather, then get your chat id):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Days to keep daily database backups in deploy/backups.
BACKUP_KEEP_DAYS=14
