{
  "name": "quiz-pro",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @quiz/shared build && pnpm --filter @quiz/api build && pnpm --filter @quiz/web build",
    "build:shared": "pnpm --filter @quiz/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @quiz/shared --filter @quiz/api --filter @quiz/web dev",
    "dev:api": "pnpm build:shared && pnpm --filter @quiz/api dev",
    "dev:web": "pnpm --filter @quiz/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @quiz/api prisma:migrate",
    "db:seed": "pnpm --filter @quiz/api prisma:seed",
    "db:studio": "pnpm --filter @quiz/api exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
